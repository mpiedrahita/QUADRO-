# ------------------------------------------------------------
# Quadro - variables de entorno de ejemplo
# Copia este archivo como .env y reemplaza los valores.
# NUNCA subas el archivo .env al repositorio.
# ------------------------------------------------------------

# Entorno: development | test | production
NODE_ENV=development

# Puerto en el que escucha la API (y la app compilada en producción)
PORT=4000

# Cadena de conexión a PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL=postgresql://quadro_user:cambia_esta_clave@localhost:5432/quadro

# Base de datos exclusiva para las pruebas de integración (se borra en cada ejecución)
TEST_DATABASE_URL=postgresql://quadro_user:cambia_esta_clave@localhost:5432/quadro_test

# Activa SSL hacia la base de datos (true en Neon, Render, Supabase, etc.)
DATABASE_SSL=false

# Base de datos exclusiva para las pruebas E2E con Playwright (se borra en cada ejecución)
E2E_DATABASE_URL=postgresql://quadro_user:cambia_esta_clave@localhost:5432/quadro_e2e

# Ruta del navegador Chrome/Chromium para Playwright (opcional; si se omite usa el canal "chrome")
# CHROME_PATH=/usr/bin/google-chrome

# Secreto para firmar los tokens de sesión (mínimo 32 caracteres aleatorios)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplaza_por_un_secreto_largo_y_aleatorio_de_al_menos_32_caracteres

# Duración de la sesión
JWT_EXPIRES_IN=8h

# Origen permitido para el frontend en desarrollo (Vite)
CLIENT_ORIGIN=http://localhost:5173

# Zona horaria usada para validar que la fecha de un gasto no sea futura
APP_TZ=America/Bogota

# Límite de intentos de inicio de sesión por IP cada 15 minutos
LOGIN_RATE_LIMIT=10
